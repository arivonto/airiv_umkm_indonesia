<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_airiv_umkm_turnover_tree" model="ir.ui.view">
            <field name="name">airiv.umkm.turnover.list</field>
            <field name="model">airiv.umkm.turnover</field>
            <field name="arch" type="xml">
                <list string="Buku Peredaran Bruto UMKM">
                    <field name="name"/>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="taxpayer_type"/>
                    <field name="gross_turnover" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="non_taxable_portion" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="taxable_dpp" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="tax_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="ntpn"/>
                    <field name="state" widget="badge"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="view_airiv_umkm_turnover_form" model="ir.ui.view">
            <field name="name">airiv.umkm.turnover.form</field>
            <field name="model">airiv.umkm.turnover</field>
            <field name="arch" type="xml">
                <form string="Peredaran Bruto &amp; PPh Final 0.5%">
                    <header>
                        <button name="action_calculate" string="Hitung PPh Final" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_mark_billed" string="Input Kode Billing" type="object" class="btn-secondary" invisible="state not in ('calculated', 'draft')"/>
                        <button name="action_mark_paid" string="Konfirmasi Setor Pajak" type="object" class="btn-success" invisible="state != 'billed'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,calculated,billed,paid"/>
                    </header>
                    <sheet>
                        <div class="oe_title mb-3">
                            <label for="name" string="Masa Pajak"/>
                            <h1 style="font-size: 26px; font-weight: 800; color: #0f172a;"><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Periode &amp; Wajib Pajak">
                                <field name="year"/>
                                <field name="month"/>
                                <field name="taxpayer_type" widget="radio"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Perhitungan PP 55/2022">
                                <field name="gross_turnover" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="cumulative_turnover_prior" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="non_taxable_portion" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="taxable_dpp" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="tax_rate"/>
                                <field name="tax_amount" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 800; color: #059669;"/>
                            </group>
                        </group>
                        <group string="Setoran &amp; Bukti Penerimaan Negara">
                            <group>
                                <field name="billing_code" placeholder="Kode e-Billing DJP"/>
                            </group>
                            <group>
                                <field name="ntpn" placeholder="16 Digit NTPN"/>
                                <field name="payment_date"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_airiv_umkm_turnover" model="ir.actions.act_window">
            <field name="name">Buku Omzet &amp; PPh Final 0.5%</field>
            <field name="res_model">airiv.umkm.turnover</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>

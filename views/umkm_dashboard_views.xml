<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_airiv_umkm_dashboard_form" model="ir.ui.view">
            <field name="name">airiv.umkm.dashboard.form</field>
            <field name="model">airiv.umkm.dashboard</field>
            <field name="arch" type="xml">
                <form string="Executive Dashboard UMKM PP 55/2022" create="false" delete="false">
                    <sheet>
                        <div class="oe_title mb-3">
                            <span class="badge bg-primary text-white mb-2 px-3 py-1">PP 55/2022 COMPLIANCE ENGINE</span>
                            <h1 style="font-size: 26px; font-weight: 800; color: #0f172a;"><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Konfigurasi Periode &amp; Wajib Pajak">
                                <field name="year"/>
                                <field name="taxpayer_type" widget="radio"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Status Threshold Rp 500 Juta">
                                <field name="is_threshold_exceeded" widget="boolean_toggle"/>
                                <field name="threshold_progress" widget="progressbar"/>
                            </group>
                        </group>
                        <group string="Ringkasan Perhitungan Pajak Final 0.5%">
                            <group>
                                <field name="total_omzet_ytd" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="omzet_bebas_pajak" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <group>
                                <field name="dpp_pph_final" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_pph_final" widget="monetary" options="{'currency_field': 'currency_id'}" style="font-weight: 800; color: #059669;"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_airiv_umkm_dashboard_tree" model="ir.ui.view">
            <field name="name">airiv.umkm.dashboard.list</field>
            <field name="model">airiv.umkm.dashboard</field>
            <field name="arch" type="xml">
                <list string="Dashboard UMKM" create="false">
                    <field name="year"/>
                    <field name="taxpayer_type"/>
                    <field name="total_omzet_ytd"/>
                    <field name="omzet_bebas_pajak"/>
                    <field name="dpp_pph_final"/>
                    <field name="total_pph_final" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="action_airiv_umkm_dashboard" model="ir.actions.act_window">
            <field name="name">Executive Dashboard UMKM</field>
            <field name="res_model">airiv.umkm.dashboard</field>
            <field name="view_mode">form,list</field>
            <field name="target">current</field>
        </record>
    </data>
</odoo>
